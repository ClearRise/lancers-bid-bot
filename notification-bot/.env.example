# =============================================================================
# notification-bot — watches Lancers job listings and tells bid-bot(s) about
# matching work. Copy to .env and adjust. Run from this folder: npm start
# =============================================================================

# -----------------------------------------------------------------------------
# Where to watch & who to notify
# -----------------------------------------------------------------------------
# 1) config/settings.json — notificationMonitorUrls: short names → full Lancers list URLs.
#
# 2) config/bid_bots.json — per bot: port/host, notificationDashboardKeys, etc.
#
# Optional: BID_BOTS_CONFIG_PATH=config/bid_bots.json
#
# Startup: exits unless at least one bid-bot answers GET /health (start bid-bot first).

# -----------------------------------------------------------------------------
# Browser login (Playwright)
# -----------------------------------------------------------------------------
# After logging in once: npm run session:save — writes this file.
STORAGE_STATE_PATH=./data/lancers-session.json
# COOKIES_PATH=./data/cookies.json

HEADLESS=true
REFRESH_INTERVAL_MS=30000

# -----------------------------------------------------------------------------
# Filters & AI (files under config/)
# -----------------------------------------------------------------------------
# settings.json — notificationMonitorUrls, includeKeywords / excludeKeywords arrays,
# aiPromptTemplate (with {{TITLE}}, {{SNIPPET}}, {{INCLUDE_KEYWORDS}}, {{EXCLUDE_KEYWORDS}}), budgets, AI toggles
# Keys below are only for providers your code actually calls (e.g. Mistral).

OPENAI_API_KEY=
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# -----------------------------------------------------------------------------
# Behaviour
# -----------------------------------------------------------------------------
# First run: record current job IDs only, no notifications (avoids a burst)
BOOTSTRAP_SILENT=true

# Per bid-bot: ./data/seen-work-ids/<bot-id>.json (legacy ./data/seen-work-ids.json migrates once on startup)
SEEN_IDS_DIR=./data/seen-work-ids
