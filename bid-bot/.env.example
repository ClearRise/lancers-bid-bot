# =============================================================================
# bid-bot — receives work IDs (HTTP), queues them, opens Lancers in a browser,
# and submits proposals. Copy to .env and adjust. Run from this folder: npm start
# =============================================================================

# -----------------------------------------------------------------------------
# Browser & login
# -----------------------------------------------------------------------------
# Logged-in session file (create with: npm run session:save)
STORAGE_STATE_PATH=./data/lancers-session.json
HEADLESS=true
# How often the idle dashboard refresh runs when monitor is enabled (ms)
POLL_INTERVAL_MS=60000

# Page to open when idle between jobs (simple dashboard/search URL is fine)
LANCERS_DASHBOARD_URL=https://www.lancers.jp/work/search

# -----------------------------------------------------------------------------
# Local data (gitignored under data/)
# -----------------------------------------------------------------------------
SEEN_IDS_PATH=./data/bid-history.json
BID_QUEUE_PATH=./data/bid-queue.json
MANUAL_BID_TASK_IDS_PATH=./data/manual-bid-task-ids.txt

# -----------------------------------------------------------------------------
# Queue & budget
# -----------------------------------------------------------------------------
# How many queued jobs to process per monitor cycle
MAX_BIDS_PER_CYCLE=2
# Optional yen filters (empty = no filter)
MIN_BUDGET_JPY=
MAX_BUDGET_JPY=
# When both min and max exist: suggested bid = min + (max-min) * this (0–1)
BUDGET_DEFINITION_RATE=0.5

# -----------------------------------------------------------------------------
# Proposals (text in form)
# -----------------------------------------------------------------------------
# ENABLE_AI_PROPOSAL=true + keys below → AI text; false → template files
ENABLE_AI_PROPOSAL=false
# Explicit mode: ai | template (if unset, derived from ENABLE_AI_PROPOSAL)
BID_PROPOSAL_MODE=template
# Templates: config/proposal_templates/template-1.txt (index 0), template-2.txt (index 1), …

INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://api.hpc-ai.com/inference/v1
INFERENCE_MODEL=minimax/minimax-m2.5

BASE44_BASE_URL=https://app.base44.com/api/agents/BASE44_CONVERSATION_ID
BASE44_CONVERSATION_ID=
BASE44_API_KEY=

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/responses
# GROQ_MODEL=openai/gpt-oss-20b

MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

# -----------------------------------------------------------------------------
# Safety & maintenance
# -----------------------------------------------------------------------------
# true = no real submits (log only)
DRY_RUN=true
# Every N queue items processed, run native-Japanese corpus study (Mistral); see src/proposals/japanese-study.ts
JAPANESE_STUDY_EVERY_N_PROPERTIES=50

# -----------------------------------------------------------------------------
# HTTP API (notification-bot POSTs here)
# -----------------------------------------------------------------------------
BID_BOT_PORT=3000

# -----------------------------------------------------------------------------
# Process layout
# -----------------------------------------------------------------------------
# true = browser worker + queue consumer in the same process as the HTTP server
ENABLE_MONITOR=true

# -----------------------------------------------------------------------------
# Desktop toast when a bid finishes (Windows/macOS/Linux)
# -----------------------------------------------------------------------------
DESKTOP_NOTIFICATION=true
WINDOWS_TOAST_APP_ID=Cursor
