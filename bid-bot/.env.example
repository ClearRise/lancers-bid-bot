# =============================================================================
# bid-bot — shared secrets only (copy to .env)
# =============================================================================
# Each profile is: __<id>/config/ and __<id>/data/ under bid-bot/ (default). Logical id stays buno; folder is __buno.
#   config/: profile.json, secrets.env, proposal_prompt.txt, proposal_templates/template-{1,2}.txt (system, web), native_japanese_sentences.txt
#   data/:   lancers-session.json, bid-queue.json, bid-history.json, manual-bid-task-ids.txt
# Optional: BID_BOT_PROFILES_DIR=./profiles to nest profiles under a folder, or create __config/instances.json with { "profilesDir": "./profiles" }.
# Workspace tooling uses __config/ and __launchers/ (auto-created). Legacy config/ and launchers/ migrate on first load.
# On first `npm start` or `session:save`, missing repo files are created: .env (copy of this file).
# Optional per-profile API overrides: __<id>/config/secrets.env
#
# Windows: run scripts from repo root (Japan\Auto): setup.bat, bid-bot-save-session.bat, bid-bot-start-all.bat, bid-bot-run-profile.bat — or __launchers\<id>.bat after setup.
# Add Japan\Auto to PATH to run those by name from any folder; set JAPAN_AUTO_REPO if you copy the .bat files elsewhere.
# CLI: npm start -- --instance <id>
# Edit profile only (no browser): npm run profile:update -- --instance <id>
#   or: npm run session:save -- --instance <id> --update-profile
# =============================================================================

# Idle monitor page (shared across instances)
LANCERS_DASHBOARD_URL=https://www.lancers.jp/work/search

# Parent folder for __<id>/config + __<id>/data (default "." = bid-bot root). Uncomment to use bid-bot/profiles/__<id>/...
# BID_BOT_PROFILES_DIR=./profiles

# --- AI proposals (shared defaults; override per profile in __<id>/config/secrets.env) ---
# Clean per-instance setup:
#   1) Keep shared defaults here only if many instances share them.
#   2) Put instance-specific keys/models in __<id>/config/secrets.env
#      e.g. __buno/config/secrets.env with:
#        BID_AI_PROVIDER=openai
#        OPENAI_API_KEY=...
#        OPENAI_MODEL=gpt-4.1-mini
#      or:
#        BID_AI_PROVIDER=mistral
#        MISTRAL_API_KEY=...
#        MISTRAL_MODEL=mistral-small-latest
# When ENABLE_AI_PROPOSAL / profile enables AI mode: which backend to use (mistral | openai).
# BID_AI_PROVIDER=mistral
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Japanese study helper (scripts/study:japanese) uses Mistral only.
# MISTRAL_API_KEY must be set for that script.

# --- Optional: only if you omit them from every profile's profile.json ---
ENABLE_MONITOR=true
DESKTOP_NOTIFICATION=true
DRY_RUN=false
