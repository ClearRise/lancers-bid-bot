# Shared repo defaults. Per profile: <id>/config/profile.json (port, toggles, budget rate) and
# <id>/config/secrets.env (API keys) override this file. Start: npm start -- --instance <id>

LANCERS_DASHBOARD_URL=https://www.lancers.jp/work/search

# AI proposals: BID_AI_PROVIDER=mistral (default) or openai. Keys in <id>/config/secrets.env override.
MISTRAL_API_KEY=WGv7J9Vw6dcJrE0el9RwxVQfGalx8IyB


# Applied only when profile.json omits the same setting (bootstrap may override from profile)
ENABLE_MONITOR=true
ENABLE_AI_PROPOSAL=true
HEADLESS=false
DRY_RUN=true
DESKTOP_NOTIFICATION=true
WINDOWS_TOAST_APP_ID=Cursor
POLL_INTERVAL_MS=60000
MAX_BIDS_PER_CYCLE=2
JAPANESE_STUDY_EVERY_N_PROPERTIES=5
# 0..1: weight between min and max budget when submitting a bid (0.5 = midpoint)
BUDGET_DEFINITION_RATE=0.5

MIN_BUDGET_JPY=
MAX_BUDGET_JPY=
