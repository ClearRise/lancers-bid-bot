{
  "name": "lancers-bid-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Automated bidding bot scaffold for lancers.jp",
  "type": "module",
  "scripts": {
    "start": "tsx src/app/index.ts",
    "bid:manual": "tsx src/app/manual-bid.ts",
