# --- Dependencies ---
node_modules/

# --- Secrets (keep **/.env.example tracked) ---
.env
.env.*
!.env.example
!**/.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# --- TypeScript / build ---
dist/
build/
*.tsbuildinfo

# --- Playwright (sessions, test output) ---
**/cookies.json
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/

# --- Bot runtime / local state (under each package's data/) ---
bid-bot/data/**
!bid-bot/data/.gitkeep
notification-bot/data/**
!notification-bot/data/.gitkeep

# --- Legacy paths at package root (old layout before data/) ---
bid-bot/bid-history.json
bid-bot/bid-queue.json
bid-bot/manual-bid-task-ids.txt
bid-bot/storage-state*.json
notification-bot/seen-work-ids.json
notification-bot/storage-state*.json
